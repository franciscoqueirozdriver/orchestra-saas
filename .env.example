# Gerado com scripts/init-env.sh; não use placeholders em produção.
# Nunca compartilhe ou versione o arquivo .env real.
POSTGRES_DB=orquestra
POSTGRES_USER=orquestra_admin
POSTGRES_PASSWORD=GERADO_PELO_SCRIPT
APP_DB_USER=orquestra_app
APP_DB_PASSWORD=GERADO_PELO_SCRIPT
JWT_SECRET=GERADO_PELO_SCRIPT
CREDENTIALS_ENCRYPTION_KEY=GERADA_PELO_SCRIPT
PUBLIC_BASE_URL=https://app.seu-dominio.com
PUBLIC_DOMAIN=app.seu-dominio.com
ZAPI_API_BASE_URL=https://api.z-api.io
ACCESS_TOKEN_MINUTES=30
ENVIRONMENT=production
UPLOAD_MAX_MB=20
EMBEDDING_DIMENSIONS=1536
MEDIA_DIR=./data/media
MESSAGE_GROUP_WINDOW_SECONDS=3

# Primeira publicação mantém mensagens suspensas até piloto autorizado.
OUTBOUND_ENABLED=false
